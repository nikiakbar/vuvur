server {
    listen 80;
    server_name localhost;

    # Serve React App
    location / {
        root   /usr/share/nginx/html;
        index  index.html;
        # This is the magic for single-page applications (like React)
        try_files $uri $uri/ /index.html;
    }

    # Proxy API requests to the backend service
    location /api/ {
        # Use a variable for the upstream host to prevent Nginx from crashing if the 'api' host is not yet available at startup.
        # 127.0.0.11 is the default Docker DNS resolver.
        resolver 127.0.0.11 valid=30s;
        set $upstream_api http://api:5000;
        
        proxy_pass $upstream_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Api-Key "${API_SECRET_KEY}";
    }
}